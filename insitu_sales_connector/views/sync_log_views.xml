<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insitu_sync_log_list" model="ir.ui.view">
        <field name="name">insitu.sync.log.list</field>
        <field name="model">insitu.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="status == 'success'" decoration-warning="status == 'warning'" decoration-danger="status == 'failed'">
                <field name="finished_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="entity"/>
                <field name="direction"/>
                <field name="status" widget="badge"/>
                <field name="processed_count" sum="Processed"/>
                <field name="error_count" sum="Errors"/>
                <field name="message" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_insitu_sync_log_form" model="ir.ui.view">
        <field name="name">insitu.sync.log.form</field>
        <field name="model">insitu.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="entity"/></h1></div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="direction"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="processed_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <group string="Details"><field name="message" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_insitu_sync_log_search" model="ir.ui.view">
        <field name="name">insitu.sync.log.search</field>
        <field name="model">insitu.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="entity"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="warning" string="Warnings" domain="[('status', '=', 'warning')]"/>
                <filter name="successful" string="Successful" domain="[('status', '=', 'success')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('finished_at', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)))]"/>
                <group>
                    <filter name="group_entity" string="Entity" context="{'group_by': 'entity'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insitu_sync_log" model="ir.actions.act_window">
        <field name="name">Synchronization Logs</field>
        <field name="res_model">insitu.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insitu_sync_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No synchronization results reported yet</p>
            <p>Logs appear after the authenticated inSitu service reports a completed synchronization run.</p>
        </field>
    </record>
</odoo>
