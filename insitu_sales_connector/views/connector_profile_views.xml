<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insitu_connector_profile_list" model="ir.ui.view">
        <field name="name">insitu.connector.profile.list</field>
        <field name="model">insitu.connector.profile</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'ready'" decoration-warning="state == 'warning'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="integration_user_id"/>
                <field name="state" widget="badge"/>
                <field name="last_sync_at"/>
                <field name="last_sync_status" widget="badge" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_insitu_connector_profile_form" model="ir.ui.view">
        <field name="name">insitu.connector.profile.form</field>
        <field name="model">insitu.connector.profile</field>
        <field name="arch" type="xml">
            <form string="inSitu Sales Connector">
                <header>
                    <button name="action_validate_setup" type="object" string="Validate Setup" class="btn-primary" groups="insitu_sales_connector.group_insitu_manager"/>
                    <button name="action_open_sync_logs" type="object" string="Sync Logs" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ready,warning,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        The inSitu service connects to Odoo. This profile displays non-secret connection details; create and share the Odoo API key through an approved secret channel.
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tenant_reference"/>
                            <field name="integration_user_id"/>
                            <field name="log_retention_days"/>
                            <field name="active"/>
                        </group>
                        <group string="Odoo Connection Details">
                            <field name="odoo_url" readonly="1"/>
                            <field name="database_name" readonly="1"/>
                            <field name="integration_login" readonly="1"/>
                            <field name="last_validated_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Readiness" name="readiness">
                            <field name="validation_message" readonly="1" nolabel="1" placeholder="Select Validate Setup to verify the Odoo-side configuration."/>
                        </page>
                        <page string="Last Synchronization" name="last_sync">
                            <group>
                                <field name="last_sync_at" readonly="1"/>
                                <field name="last_sync_status" readonly="1" widget="badge"/>
                            </group>
                            <field name="last_sync_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_insitu_connector_profile_search" model="ir.ui.view">
        <field name="name">insitu.connector.profile.search</field>
        <field name="model">insitu.connector.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="integration_user_id"/>
                <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                <filter name="needs_attention" string="Needs Attention" domain="[('state', 'in', ['draft', 'warning', 'error'])]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insitu_connector_profile" model="ir.actions.act_window">
        <field name="name">Connector Profiles</field>
        <field name="res_model">insitu.connector.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_insitu_connector_profile_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure the Odoo side of inSitu Sales</p>
            <p>Create one profile per Odoo company, select a dedicated integration user, and validate the setup.</p>
        </field>
    </record>
</odoo>
