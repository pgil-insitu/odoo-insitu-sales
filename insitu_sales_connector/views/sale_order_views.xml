<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_insitu" model="ir.ui.view">
        <field name="name">sale.order.form.inSitu</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="inSitu Sales" name="insitu_sales" groups="insitu_sales_connector.group_insitu_integration">
                    <group>
                        <field name="insitu_origin"/>
                        <field name="insitu_external_id"/>
                        <field name="insitu_last_sync_at" readonly="1"/>
                        <field name="insitu_sync_status" widget="badge"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
