<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_insitu_sales" model="ir.module.category">
        <field name="name">inSitu Sales</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_insitu_sales" model="res.groups.privilege">
        <field name="name">Connector</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_insitu_sales"/>
    </record>

    <record id="group_insitu_integration" model="res.groups">
        <field name="name">Integration Service</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_insitu_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Allows the authenticated inSitu service user to read connector readiness and report synchronization results.</field>
    </record>

    <record id="group_insitu_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_insitu_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('group_insitu_integration'))]"/>
        <field name="comment">Allows connector configuration, validation, log review, and log cleanup.</field>
    </record>
</odoo>
