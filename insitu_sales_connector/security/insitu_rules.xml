<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_insitu_profile_company" model="ir.rule">
        <field name="name">inSitu connector profiles by company</field>
        <field name="model_id" ref="model_insitu_connector_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insitu_integration'))]"/>
    </record>

    <record id="rule_insitu_log_company" model="ir.rule">
        <field name="name">inSitu synchronization logs by company</field>
        <field name="model_id" ref="model_insitu_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_insitu_integration'))]"/>
    </record>
</odoo>
